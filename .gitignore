.claude/settings.local.json

# Fotos enviadas pelos usuários (dados reais, não vão pro repositório)
Servidor/uploads/**
!Servidor/uploads/**/
!Servidor/uploads/**/.gitkeep
!Servidor/uploads/.htaccess
